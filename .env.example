# Required. Production remains "supabase" until the coordinated cutover.
VITE_PLATFORM_MODE=supabase

# Required absolute WebICT Capital API origin. Do not include a trailing slash.
VITE_MARKET_API_BASE_URL=https://api.example.invalid

# Required only while VITE_PLATFORM_MODE=supabase.
VITE_SUPABASE_URL=https://project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-public-anon-key

# Never put a Supabase service-role key or another privileged secret in VITE_*.
